# Infrastructure controls; application settings are read from .env.
# scripts/local.py preserves these values and generates LOCAL_* DB URL overrides.
LOCAL_API_PORT=18000
LOCAL_API_WORKERS=4
LOCAL_EVENT_WORKER_PORT=18011
LOCAL_POSTGRES_PORT=15432
LOCAL_REDIS_PORT=16379
LOCAL_POSTGRES_PASSWORD=replace-with-local-random-password
