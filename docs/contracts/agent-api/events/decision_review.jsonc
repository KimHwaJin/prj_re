// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 계약 형식 버전. SSE는 1, 새 Workflow는 2.0-draft, legacy 예제는 1.3을 사용한다. 정의 수정 횟수와 구분한다.
  "schema_version": 1,
  // 콘텐츠 블록에서는 text/image/file, SSE envelope에서는 이벤트 이름을 구분한다. 이 객체의 실제 값을 기준으로 해석한다.
  "type": "interaction.opened",
  // 저장 SSE 이벤트의 순번. 실제 전송의 id 및 재연결 Last-Event-ID에 대응한다.
  "sequence": 2,
  // 대화 세션 UUID. 같은 세션의 동시 실행은 제한되며 다른 세션과 구분된다.
  "session_id": "22222222-2222-4222-8222-222222222222",
  // 사용자 요청 전체 흐름의 공개 Run UUID. resume에서도 같은 Run을 이어간다.
  "run_id": "11111111-1111-4111-8111-111111111111",
  // 저장 이벤트 발생 시각. 현재 상태 snapshot에는 없는 필드다.
  "occurred_at": "2026-10-01T00:00:00Z",
  // SSE 이벤트의 실제 payload. type/kind에 따라 메시지·HITL·현재 Run 상태 등 구조가 달라진다.
  "data": {
    // 현재 HITL 확인 화면을 식별하는 UUID. 질문·판단·수정 액션은 이 화면을 대상으로 한다.
    "interaction_id": "44444444-4444-4444-8444-444444444444",
    // HITL 화면 버전. plan_revision 및 Workflow definition_version과 별개다.
    "revision": 1,
    // HITL 화면 상태. open은 응답 대기, resolved는 해당 확인 절차 종료다.
    "status": "open",
    // 현재 사용자 재개 대상을 확인하는 UUID 토큰. 서버가 내려준 최신 값을 사용한다. 로그인 인증 토큰이 아니다.
    "resume_token": "33333333-3333-4333-8333-333333333333",
    // HITL 화면 종류. plan_review=계획, planning_question=추가 질문, decision_review=결과 판단, repair_review=오류 수정 확인이다.
    "kind": "decision_review",
    // 사용자에게 표시할 핵심 설명. 실제 상세 정보는 payload나 관련 필드를 함께 확인한다.
    "summary": "이상치 분석 여부와 방법을 확인해 주세요.",
    // 해당 HITL 또는 이벤트 종류의 세부 데이터. 계획·질문·판단·수정 제안을 담는다.
    "payload": {
      // 실행 결과를 보고 나중에 확정할 판단 목록. 정적 계획과 결과 기반 판단을 분리한다.
      "decisions": [
        {
          // 결과 기반 Agent 판단의 ID. 판단 정의·확인 화면·Tool 인자의 연결에 사용한다.
          "decision_id": "inspect_outliers",
          // Agent 판단 또는 지연 파라미터 선택에 적용할 지침. 사용자에게 선택 근거와 함께 보여줄 수 있다.
          "guidance": "품질 결과와 기술 통계에 비추어 이상치 후보 확인이 유효한지 판단한다. 근거가 부족하면 사용자에게 확인하고, 추측으로 실행하지 않는다.",
          // 판단 또는 보고서가 근거로 사용할 Step ID 목록. 실제 실행 결과를 사용한다.
          "evidence_steps": [
            "profile",
            "statistics"
          ],
          // 입력·편집값을 검증하는 JSON Schema 객체 또는 boolean. 필수 여부 및 값 유효성은 별도다.
          "value_schema": {
            // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
            "type": "boolean"
          },
          // 값이 실제로 정해져 있는지 표시한다. value=null 자체만으로 미확정이라고 판단하지 않는다.
          "has_value": false
        },
        {
          // 결과 기반 Agent 판단의 ID. 판단 정의·확인 화면·Tool 인자의 연결에 사용한다.
          "decision_id": "outlier_method",
          // Agent 판단 또는 지연 파라미터 선택에 적용할 지침. 사용자에게 선택 근거와 함께 보여줄 수 있다.
          "guidance": "이상치 탐지가 필요한 경우 Skill 지침과 통계 결과에 맞는 방법을 선택한다.",
          // 판단 또는 보고서가 근거로 사용할 Step ID 목록. 실제 실행 결과를 사용한다.
          "evidence_steps": [
            "profile",
            "statistics"
          ],
          // 입력·편집값을 검증하는 JSON Schema 객체 또는 boolean. 필수 여부 및 값 유효성은 별도다.
          "value_schema": {
            // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
            "type": "string",
            // 허용하는 값 목록.
            "enum": [
              "iqr",
              "zscore",
              "isolation_forest"
            ]
          },
          // 값이 실제로 정해져 있는지 표시한다. value=null 자체만으로 미확정이라고 판단하지 않는다.
          "has_value": false
        }
      ]
    }
  }
}
