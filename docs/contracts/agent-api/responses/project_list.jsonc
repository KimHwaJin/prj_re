// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 현재 페이지의 프로젝트 요약 목록. system_prompt·prompt_version과 하위 세션/메시지는 포함하지 않는다.
  "items": [
    {
      // 프로젝트 UUID. 요청 경로에서는 project_id, 기존 공개 응답 필드는 id다.
      "id": "22222222-2222-4222-8222-222222222222",
      // 프로젝트 표시 이름. 요청 body에서는 project_name을 사용한다.
      "name": "품질 분석",
      // 사용자의 기본 프로젝트인지. 개별 이름 변경·삭제는 허용하지 않는다.
      "is_default": false,
      // 프로젝트 최초 생성 시각.
      "created_at": "2026-10-04T09:00:00Z",
      // 프로젝트 레코드 변경 시각. 하위 세션의 최근 대화 시각을 뜻하지 않는다.
      "updated_at": "2026-10-04T09:05:00Z"
    }
  ],
  // 목록 응답의 페이지 정보.
  "page": {
    // 다음 목록 페이지 요청에 사용할 cursor. 다음 페이지가 없으면 null일 수 있다.
    "next_cursor": null,
    // 다음 목록 페이지가 존재하는지 표시한다.
    "has_next": false
  }
}
