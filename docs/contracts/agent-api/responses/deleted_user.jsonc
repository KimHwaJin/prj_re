// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 서비스 공개 문자열 사용자 ID. 내부 UUID가 아니며 SSO 사번과 연결된다.
  "user_id": "employee-002",
  // 사용자 표시 이름. 중복 가능하며 공개 ID와 별개다.
  "user_name": "김철수",
  // 서비스 권한 admin 또는 user. 호출자 권한은 로그인한 사용자 DB 역할로 판단한다.
  "role": "user",
  // 활성 기본 프로젝트 UUID. 삭제 등으로 없으면 null이며 조회에서 생성하지 않는다.
  "default_project_id": null,
  // N은 활성, Y는 soft delete. 관리자 상세는 삭제된 사용자도 읽으며 복구하지 않는다.
  "delete_yn": "Y",
  // 사용자 최초 등록 시각.
  "created_at": "2026-10-01T00:00:00Z",
  // 사용자 레코드 최종 변경 시각. 로그인 세션 만료 시각과 별개다.
  "updated_at": "2026-10-04T00:00:00Z",
  // 사용자의 soft delete 시각. 활성 사용자는 null이다.
  "deleted_at": "2026-10-04T00:00:00Z"
}
