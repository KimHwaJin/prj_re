// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 현재 페이지의 내부 실행 구간 목록. 총 개수나 공개 Run 목록이 아니다.
  "items": [
    {
      // 최초 실행·각 resume마다 생성되는 내부 실행 구간 UUID. 공개 Run ID와 다르다.
      "invocation_id": "55555555-5555-4555-8555-555555555555",
      // HITL 재개 전후에 유지되는 공개 Run ID. 내부 invocation_id와 구분한다.
      "run_id": "11111111-1111-4111-8111-111111111111",
      // 내부 Task 레코드 UUID. API 조회 주소는 공개 run_id를 사용한다. 과거 Task 없는 invocation은 null이다.
      "task_id": "44444444-4444-4444-8444-444444444444",
      // 이 공개 Run이 속한 대화 세션 UUID.
      "session_id": "22222222-2222-4222-8222-222222222222",
      // 내부 실행 구간 상태 pending/running/interrupted/success/error/timeout/canceled. 공개 Run 전체 상태와 구분한다.
      "status": "interrupted",
      // 해당 invocation을 Worker가 점유한 횟수. 최초 시도도 포함한다.
      "attempt_count": 1,
      // 해당 invocation을 다시 점유할 수 있는 다음 재시도 시각.
      "next_attempt_at": null,
      // 취소 요청이 기록된 시각. 실제 종료 확인과 별개다.
      "cancel_requested_at": null,
      // 해당 invocation에 기록된 취소 사유.
      "cancel_reason": null,
      // 해당 실행 구간에 기록된 실패 객체. 생산자가 정한 진단 형식이며 공개 Run 최종 결과가 아니다.
      "failure": null,
      // 해당 Task 또는 invocation 레코드의 DB 생성 시각.
      "created_at": "2026-10-01T00:00:00Z",
      // 해당 Task 또는 invocation 레코드의 마지막 갱신 시각.
      "updated_at": "2026-10-01T00:00:00Z",
      // 해당 invocation의 실제 실행 시작 기록 시각.
      "started_at": "2026-10-01T00:00:00Z",
      // 해당 Task 또는 invocation의 기록된 종료 시각. invocation 종료는 공개 Run 전체 완료와 다르다.
      "completed_at": "2026-10-01T00:00:00Z"
    }
  ],
  // 목록 응답의 페이지 정보.
  "page": {
    // 다음 목록 페이지가 존재하는지 표시한다.
    "has_next": false,
    // 다음 목록 페이지 요청에 사용할 cursor. 다음 페이지가 없으면 null일 수 있다.
    "next_cursor": null
  }
}
