// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 현재 페이지의 진단 로그 목록. 프론트 진행/HITL에는 SSE를 사용한다.
  "items": [
    {
      // 개별 저장 로그 UUID. SSE sequence나 resume_token과 무관하다.
      "log_id": "33333333-3333-4333-8333-333333333333",
      // HITL 재개 전후에 유지되는 공개 Run ID.
      "run_id": "11111111-1111-4111-8111-111111111111",
      // 내부 invocation 내 중복 저장 방지 키. 공개 Run 전체에서 유일하지 않을 수 있다.
      "event_key": "planning:result:1",
      // 기록을 남긴 Agent 이름. 특정되지 않은 기록은 null이다.
      "agent_name": "planner",
      // 기록을 남긴 그래프 노드 또는 실행 위치.
      "node": "planning",
      // 기록 생산자가 부여한 이벤트 이름.
      "event": "result",
      // 로그 분류 문자열. HITL 화면 kind와 별개다.
      "kind": "agent",
      // 생산자가 저장한 진단 객체. 종류별 형식이 다르며 SSE 응답으로 해석하지 않는다.
      "payload": {
      },
      // DB 로그 저장 시각. 외부 작업의 실제 발생 시각이나 인과 순서를 보장하지 않는다.
      "created_at": "2026-10-01T00:00:00Z"
    }
  ],
  // 목록 응답의 페이지 정보.
  "page": {
    // 다음 목록 페이지가 존재하는지 표시한다.
    "has_next": false,
    // 다음 목록 페이지 요청에 사용할 cursor. 다음 페이지가 없으면 null일 수 있다.
    "next_cursor": null
  }
}
