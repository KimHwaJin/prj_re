// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // HITL 재개 전후에 유지되는 공개 Run ID. 내부 invocation_id와 구분한다.
  "run_id": "11111111-1111-4111-8111-111111111111",
  // 이 공개 Run이 속한 대화 세션 UUID.
  "session_id": "22222222-2222-4222-8222-222222222222",
  // 이 진단 SQL statement의 DB 관측 시각. 실행 완료나 heartbeat 시각이 아니다.
  "observed_at": "2026-10-01T00:00:00Z",
  // 최신 실행 구간에 연결된 내부 Task 진단 정보. 연결이 없거나 다른 Session/Run이면 null이다.
  "task": {
    // 내부 Task 레코드 UUID. API 조회 주소는 공개 run_id를 사용한다. 과거 Task 없는 invocation은 null이다.
    "task_id": "44444444-4444-4444-8444-444444444444",
    // Agent 그래프에서 사용하는 분석 작업 ID. 서비스 task_id와 별개다.
    "graph_task_id": null,
    // Task에 기록된 최초 실행 구간 ID.
    "root_run_id": "11111111-1111-4111-8111-111111111111",
    // Task에 기록된 LangGraph checkpoint 기준 ID. 진단값이며 API 경로를 조립하는 값이 아니다.
    "checkpoint_run_id": "11111111-1111-4111-8111-111111111111",
    // 내부 Task를 시작하게 한 메시지 UUID.
    "trigger_message_id": null,
    // 내부 Task의 실행 계기 분류 문자열.
    "trigger_type": "pending_route",
    // 내부 Task 상태. waiting_input은 사용자 승인 또는 Executor 대기 모두 가능하므로 UI는 공개 Run status를 사용한다.
    "status": "waiting_input",
    // 이 Task가 미종료 상태이거나 복구 확인이 필요한지. 세션 전체 상태와 별개다.
    "is_unfinished": true,
    // Task lease에 기록된 소유자. 현재 그래프 점유는 session_work.execution에서 확인한다.
    "lock_owner": null,
    // 마지막으로 기록된 heartbeat 시각. 오래됐다는 이유만으로 종료나 미점유를 확정하지 않는다.
    "heartbeat_at": null,
    // 기록된 Task lease 만료 시각. 세션 점유 해제나 재실행 허가를 뜻하지 않는다.
    "lease_expires_at": null,
    // 취소 요청이 기록된 시각. 실제 종료 확인과 별개다.
    "cancel_requested_at": null,
    // Task에 기록된 내부 실패 사유.
    "failure_reason": null,
    // Task 또는 실행 점유에 대한 복구 확인 필요 여부. 이 조회는 복구를 실행하지 않는다.
    "recovery_required": false,
    // 해당 Task 또는 invocation 레코드의 DB 생성 시각.
    "created_at": "2026-10-01T00:00:00Z",
    // 해당 Task 또는 invocation 레코드의 마지막 갱신 시각.
    "updated_at": "2026-10-01T00:00:00Z",
    // 해당 Task 또는 invocation의 기록된 종료 시각. invocation 종료는 공개 Run 전체 완료와 다르다.
    "completed_at": null
  },
  // 해당 Run뿐 아니라 같은 세션 전체의 현재 미완료 작업·점유 진단이다.
  "session_work": {
    // 연결된 User·Project·Session이 모두 활성인지. 관리자만 숨김 자원도 조회한다.
    "resources_active": true,
    // 세션 전체에 미종료 작업·복구 필요·점유 또는 종료 불명이 존재하는지.
    "has_unfinished_work": true,
    // 새 일반 입력에 대한 보수적 진단 snapshot. HITL 재개 권한이나 예약이 아니며 UI는 세션 availability, POST는 실제 재검사를 사용한다.
    "can_start_new_run": false,
    // 세션 전체의 새 일반 입력 차단 원인 목록. 사용자용 availability.reason과 별개의 내부 진단이다.
    "blocking_reasons": [
      "unfinished_task"
    ],
    // 같은 세션의 현재 실행 점유 기록. 조회한 Run과 다른 Run의 점유일 수도 있다.
    "execution": {
      // DB에 세션 실행 점유가 기록되어 있는지. 워커의 실제 생존을 입증하지 않는다.
      "ownership_held": false,
      // 기록된 점유 종류. api_run 또는 executor_event 등.
      "owner_kind": null,
      // 기록된 점유자 ID. 공개 Run 조회 경로를 조립하는 값이 아니다.
      "owner_id": null,
      // 점유자로 기록된 프로세스 식별 문자열.
      "owner_process": null,
      // 기록된 세션 실행 점유 획득 시각.
      "acquired_at": null,
      // 마지막으로 기록된 heartbeat 시각. 오래됐다는 이유만으로 종료나 미점유를 확정하지 않는다.
      "heartbeat_at": null,
      // Task 또는 실행 점유에 대한 복구 확인 필요 여부. 이 조회는 복구를 실행하지 않는다.
      "recovery_required": false,
      // 세션 실행 점유 복구 확인이 필요한 것으로 기록된 사유.
      "recovery_reason": null
    }
  }
}
