// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 현재 페이지의 사용자 요약 목록. 기본 프로젝트·로그인 세션 정보는 포함하지 않는다.
  "items": [
    {
      // 서비스 공개 문자열 사용자 ID. 내부 UUID가 아니며 SSO 사번과 연결된다.
      "user_id": "employee-001",
      // 사용자 표시 이름. 중복 가능하며 공개 ID와 별개다.
      "user_name": "홍길동",
      // 서비스 권한 admin 또는 user. 호출자 권한은 로그인한 사용자 DB 역할로 판단한다.
      "role": "user",
      // 사용자가 soft delete되지 않았는지. 로그인 세션의 유효성이나 자동 복구를 뜻하지 않는다.
      "is_active": true,
      // 사용자 최초 등록 시각.
      "created_at": "2026-10-01T00:00:00Z",
      // 사용자 레코드 최종 변경 시각. 로그인 세션 만료 시각과 별개다.
      "updated_at": "2026-10-01T00:00:00Z",
      // 사용자의 soft delete 시각. 활성 사용자는 null이다.
      "deleted_at": null
    }
  ],
  // 목록 응답의 페이지 정보.
  "page": {
    // 다음 목록 페이지 요청에 사용할 cursor. 다음 페이지가 없으면 null일 수 있다.
    "next_cursor": null,
    // 다음 목록 페이지가 존재하는지 표시한다.
    "has_next": false
  }
}
