// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 등록된 모델 별칭. 새 요청에서 생략하면 기본 모델을 사용하며 재개에서는 바꿀 수 없다.
  "main_model_name": "default",
  // Run에 고정된 모델 설정 revision. Workflow나 승인 화면의 revision과 별개다.
  "model_revision": "docs-example",
  // 사용자 요청 전체 흐름의 공개 Run UUID. resume에서도 같은 Run을 이어간다.
  "run_id": "11111111-1111-4111-8111-111111111111",
  // 대화 세션 UUID. 같은 세션의 동시 실행은 제한되며 다른 세션과 구분된다.
  "session_id": "22222222-2222-4222-8222-222222222222",
  // Run 상태: pending/running/waiting_input/waiting_executor/success/error/timeout/canceled/recovery_required. 접수·승인과 실행 완료는 구분한다.
  "status": "waiting_input",
  // 현재 사용자 재개 대상을 확인하는 UUID 토큰. 서버가 내려준 최신 값을 사용한다. 로그인 인증 토큰이 아니다.
  "resume_token": "33333333-3333-4333-8333-333333333333",
  // Run이 대기 중인 사용자 확인 화면 목록. 보통 kind에 맞춰 UI를 구성한다. 현재 대기가 없으면 null일 수 있다.
  "interrupt": [
    {
      // 현재 HITL 확인 화면을 식별하는 UUID. 질문·판단·수정 액션은 이 화면을 대상으로 한다.
      "interaction_id": "44444444-4444-4444-8444-444444444444",
      // HITL 화면 버전. plan_revision 및 Workflow definition_version과 별개다.
      "revision": 1,
      // Run 상태: pending/running/waiting_input/waiting_executor/success/error/timeout/canceled/recovery_required. 접수·승인과 실행 완료는 구분한다.
      "status": "open",
      // 현재 사용자 재개 대상을 확인하는 UUID 토큰. 서버가 내려준 최신 값을 사용한다. 로그인 인증 토큰이 아니다.
      "resume_token": "33333333-3333-4333-8333-333333333333",
      // HITL 화면 종류. plan_review=계획, planning_question=추가 질문, decision_review=결과 판단, repair_review=오류 수정 확인이다.
      "kind": "plan_review",
      // 사용자에게 표시할 핵심 설명. 실제 상세 정보는 payload나 관련 필드를 함께 확인한다.
      "summary": "계획과 입력값을 확인하고 승인해 주세요.",
      // 해당 HITL 또는 이벤트 종류의 세부 데이터. 계획·질문·판단·수정 제안을 담는다.
      "payload": {
        // 사용자에게 제시하는 코드 없는 PlanView 후보 목록. 설정된 최대 후보 수 범위에서 제시된다.
        "plans": [
          {
            // 서버가 생성한 계획 후보 ID. 사용자 선택·편집·승인 시 현재 화면의 값을 그대로 보낸다.
            "plan_id": "55555555-5555-4555-8555-555555555555",
            // 계획 편집 버전. 현재 화면 값과 다르면 stale 요청으로 거절된다.
            "plan_revision": 1,
            // 재사용 Workflow 정의를 식별하는 문자열. 기존 Workflow 관리 API의 DB UUID와 구분한다.
            "workflow_id": "quality_review",
            // registered는 등록 자산 조합, free_code는 실행별 자유 코드가 포함된 계획이다.
            "execution_kind": "registered",
            // 등록된 Skill·Tool만의 재사용 Workflow로 인정할 수 있는지 표시한다. 실행 성공과 별개이며 수정 소스·자유 코드는 적격이 아닐 수 있다.
            "workflow_eligible": true,
            // user는 사용자 승인, configuration은 설정에 따른 승인 처리다.
            "approval_mode": "user",
            // 동일 Workflow 정의의 변경 버전. 승인 화면 편집 횟수나 Run ID가 아니다.
            "definition_version": 1,
            // 사용자에게 표시할 Workflow 또는 계획 이름. 고유 식별자는 workflow_id/plan_id로 별도 관리한다.
            "name": "저장된 데이터의 품질과 이상치 후보 확인",
            // Workflow 또는 계획이 달성하려는 분석 목표.
            "goal": "기본 품질과 기술 통계를 확인하고 필요한 경우 이상치 후보를 설명한다.",
            // 계획에 사용되는 등록 Skill 정보 목록. Skill은 Tool 묶음과 사용 지침을 제공한다.
            "skills": [
              {
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_load",
                // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                "name": "data_load",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "data_load"
              },
              {
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_quality_check",
                // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                "name": "data_quality_check",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "data_quality_check"
              }
            ],
            // 새 Workflow에서는 입력 이름별 정의 객체, PlanView에서는 입력 필드 목록, legacy에서는 실행 입력값 객체다.
            "inputs": [
              {
                // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                "name": "dataset",
                // 사용자 화면의 표시 제목. value_schema 내부에서는 JSON Schema 표시 제목이다.
                "title": "분석 데이터",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "실행 가능한 Parquet 파일의 검증된 참조. 원본 경로를 사용자가 임의로 지정하는 API가 아니다.",
                // 입력 종류. parameter는 일반 값, data_reference는 서버가 접근을 확인한 데이터 참조다. 임의 파일 경로 입력과 구분한다.
                "kind": "data_reference",
                // 업무 입력·산출물에서는 필요한지 나타내는 boolean. JSON Schema에서는 필수 필드 이름 배열이다.
                "required": true,
                // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                "editable": true,
                // 입력·편집값을 검증하는 JSON Schema 객체 또는 boolean. 필수 여부 및 값 유효성은 별도다.
                "value_schema": {
                  // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
                  "type": "string",
                  // 허용 문자열의 최소 길이.
                  "minLength": 1
                },
                // 입력값이 정해진 출처. agent/workflow_default/user/unresolved를 구분한다.
                "origin": "agent",
                // 값이 실제로 정해져 있는지 표시한다. value=null 자체만으로 미확정이라고 판단하지 않는다.
                "has_value": true,
                // 직접 지정한 값·편집값·판단값. 의미와 허용 타입은 해당 입력 또는 파라미터 schema를 따른다.
                "value": "default-nce"
              }
            ],
            // 분석 단계 목록. 새 Workflow의 Step은 하나의 등록 Tool을 참조하며 depends_on으로 선후관계를 정한다.
            "steps": [
              {
                // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                "step_id": "load",
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_load",
                // 레포에 등록된 실행 가능한 Tool의 고유 식별자.
                "tool_id": "data_load",
                // Executor에서 실행할 Tool의 Python 함수 이름. 함수 본문은 공개 계획에 포함하지 않는다.
                "function_name": "data_load",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "검증된 데이터 참조를 로드한다.",
                // 먼저 완료되어야 하는 Step ID 목록. 단순 배열 순서와 구분되며 순환 의존성은 허용하지 않는다.
                "depends_on": [],
                // 사용자에게 보여주는 Tool 함수 인자 목록. kind와 editable에 따라 값 표시·편집 UI를 구성한다.
                "parameters": [
                  {
                    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                    "name": "parquet_path",
                    // 함수 인자 값의 출처. workflow_input=입력 참조, literal=직접값, step_reference=이전 반환값, deferred=결과 이후 판단, system_context=서버 문맥이다.
                    "kind": "workflow_input",
                    // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                    "editable": false,
                    // 이 인자가 참조하는 Workflow 입력 이름. 값은 대응하는 입력 필드에서 편집한다.
                    "input_name": "dataset"
                  }
                ],
                // Run 상태: pending/running/waiting_input/waiting_executor/success/error/timeout/canceled/recovery_required. 접수·승인과 실행 완료는 구분한다.
                "status": "planned"
              },
              {
                // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                "step_id": "profile",
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_quality_check",
                // 레포에 등록된 실행 가능한 Tool의 고유 식별자.
                "tool_id": "profile_data",
                // Executor에서 실행할 Tool의 Python 함수 이름. 함수 본문은 공개 계획에 포함하지 않는다.
                "function_name": "profile_data",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "기본 구조와 결측 상태를 확인한다.",
                // 먼저 완료되어야 하는 Step ID 목록. 단순 배열 순서와 구분되며 순환 의존성은 허용하지 않는다.
                "depends_on": [
                  "load"
                ],
                // 사용자에게 보여주는 Tool 함수 인자 목록. kind와 editable에 따라 값 표시·편집 UI를 구성한다.
                "parameters": [
                  {
                    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                    "name": "data",
                    // 함수 인자 값의 출처. workflow_input=입력 참조, literal=직접값, step_reference=이전 반환값, deferred=결과 이후 판단, system_context=서버 문맥이다.
                    "kind": "step_reference",
                    // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                    "editable": false,
                    // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                    "step_id": "load",
                    // 이전 Step 반환값에서 추출할 키·인덱스 경로 배열. []는 반환값 전체이며 새 규격은 Python 식을 평가하지 않는다. legacy는 문자열 selector다.
                    "selector": []
                  }
                ],
                // Run 상태: pending/running/waiting_input/waiting_executor/success/error/timeout/canceled/recovery_required. 접수·승인과 실행 완료는 구분한다.
                "status": "planned"
              },
              {
                // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                "step_id": "statistics",
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_quality_check",
                // 레포에 등록된 실행 가능한 Tool의 고유 식별자.
                "tool_id": "compute_statistics",
                // Executor에서 실행할 Tool의 Python 함수 이름. 함수 본문은 공개 계획에 포함하지 않는다.
                "function_name": "compute_statistics",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "컬럼별 기술 통계를 확인한다.",
                // 먼저 완료되어야 하는 Step ID 목록. 단순 배열 순서와 구분되며 순환 의존성은 허용하지 않는다.
                "depends_on": [
                  "load"
                ],
                // 사용자에게 보여주는 Tool 함수 인자 목록. kind와 editable에 따라 값 표시·편집 UI를 구성한다.
                "parameters": [
                  {
                    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                    "name": "data",
                    // 함수 인자 값의 출처. workflow_input=입력 참조, literal=직접값, step_reference=이전 반환값, deferred=결과 이후 판단, system_context=서버 문맥이다.
                    "kind": "step_reference",
                    // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                    "editable": false,
                    // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                    "step_id": "load",
                    // 이전 Step 반환값에서 추출할 키·인덱스 경로 배열. []는 반환값 전체이며 새 규격은 Python 식을 평가하지 않는다. legacy는 문자열 selector다.
                    "selector": []
                  }
                ],
                // Run 상태: pending/running/waiting_input/waiting_executor/success/error/timeout/canceled/recovery_required. 접수·승인과 실행 완료는 구분한다.
                "status": "planned"
              },
              {
                // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                "step_id": "outliers",
                // 레포에 등록된 Skill의 고유 식별자. 그 Skill에 속한 Tool을 참조해야 한다.
                "skill_id": "data_quality_check",
                // 레포에 등록된 실행 가능한 Tool의 고유 식별자.
                "tool_id": "detect_outliers",
                // Executor에서 실행할 Tool의 Python 함수 이름. 함수 본문은 공개 계획에 포함하지 않는다.
                "function_name": "detect_outliers",
                // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
                "description": "원본을 수정하지 않고 이상치 후보를 확인한다.",
                // 먼저 완료되어야 하는 Step ID 목록. 단순 배열 순서와 구분되며 순환 의존성은 허용하지 않는다.
                "depends_on": [
                  "load",
                  "profile",
                  "statistics"
                ],
                // 사용자에게 보여주는 Tool 함수 인자 목록. kind와 editable에 따라 값 표시·편집 UI를 구성한다.
                "parameters": [
                  {
                    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                    "name": "data",
                    // 함수 인자 값의 출처. workflow_input=입력 참조, literal=직접값, step_reference=이전 반환값, deferred=결과 이후 판단, system_context=서버 문맥이다.
                    "kind": "step_reference",
                    // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                    "editable": false,
                    // 대상 Step의 ID. 편집 대상으로 지정하거나 이전 결과·의존성·근거를 참조할 때 쓴다.
                    "step_id": "load",
                    // 이전 Step 반환값에서 추출할 키·인덱스 경로 배열. []는 반환값 전체이며 새 규격은 Python 식을 평가하지 않는다. legacy는 문자열 selector다.
                    "selector": []
                  },
                  {
                    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다.
                    "name": "method",
                    // 함수 인자 값의 출처. workflow_input=입력 참조, literal=직접값, step_reference=이전 반환값, deferred=결과 이후 판단, system_context=서버 문맥이다.
                    "kind": "deferred",
                    // 사용자가 수정할 수 있는지 표시한다. true여도 value_schema 및 실행 정책 검증을 통과해야 한다.
                    "editable": true,
                    // 입력·편집값을 검증하는 JSON Schema 객체 또는 boolean. 필수 여부 및 값 유효성은 별도다.
                    "value_schema": {
                      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
                      "type": "string",
                      // 허용하는 값 목록.
                      "enum": [
                        "iqr",
                        "zscore",
                        "isolation_forest"
                      ]
