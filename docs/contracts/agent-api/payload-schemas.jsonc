          "values": {
            // 판단 ID additionalProperties의 최종값. 현재 판단 화면의 value_schema를 만족해야 한다.
            "additionalProperties": true,
            // 판단 ID title의 최종값. 현재 판단 화면의 value_schema를 만족해야 한다.
