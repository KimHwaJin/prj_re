// 필드별 한국어 설명. 문서용 JSONC이며 API 제출에는 같은 이름의 .json을 사용한다.
{
  // 새 입력 또는 현재 Run의 사용자 재개 요청.
  "RunRequest": {
    // 이 Schema에서 재사용하는 타입 정의 모음.
    "$defs": {
      // 콘텐츠 블록을 담는 새 사용자 입력.
      "ChatInput": {
        // 정의되지 않은 필드 허용 여부 또는 동적 키의 값 schema. false면 임의 필드를 거절한다.
        "additionalProperties": false,
        // 객체 필드 이름별 검증 규칙.
        "properties": {
          // 입력 또는 Agent 메시지의 콘텐츠 블록 배열. 블록의 type으로 형식을 구분한다. 필수 필드.
          "content": {
            // 배열 원소에 적용할 Schema.
            "items": {
              // 선택 구조를 구분하는 필드 정보.
              "discriminator": {
                // 판별값과 대상 Schema 참조의 매핑.
                "mapping": {
                  // 선택 판별값 file에 대응하는 Schema 참조.
                  "file": "#/$defs/FileContent",
                  // 선택 판별값 image에 대응하는 Schema 참조.
                  "image": "#/$defs/ImageContent",
                  // 사용자 입력 또는 Agent 메시지 본문 문자열.
                  "text": "#/$defs/TextContent"
                },
                // 선택 구조를 판별할 필드 이름.
                "propertyName": "type"
              },
              // 열거한 Schema 중 정확히 하나에 맞아야 하는 선택 구조.
              "oneOf": [
                {
                  // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
                  "$ref": "#/$defs/TextContent"
                },
                {
                  // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
                  "$ref": "#/$defs/ImageContent"
                },
                {
                  // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
                  "$ref": "#/$defs/FileContent"
                }
              ]
            },
            // 허용 배열의 최대 원소 수.
            "maxItems": 20,
            // 허용 배열의 최소 원소 수.
            "minItems": 1,
            // 사용자 화면의 표시 제목. value_schema 내부에서는 JSON Schema 표시 제목이다.
            "title": "Content",
            // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
            "type": "array",
            // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
            "description": "입력 또는 Agent 메시지의 콘텐츠 블록 배열. 블록의 type으로 형식을 구분한다. 필수 필드."
          }
        },
        // 해당 객체에서 반드시 포함할 필드 이름 배열. 값이 null인지와 필드 생략 가능 여부는 별개다.
