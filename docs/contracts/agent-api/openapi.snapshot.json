            "type": "string",
            "format": "uuid",
            "title": "Interaction Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Values"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
