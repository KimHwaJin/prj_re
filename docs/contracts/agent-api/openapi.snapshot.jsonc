          // 유효성 검증 오류의 부가 문맥. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다.
          "ctx": {
            // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
            "type": "object",
            // 사용자 화면의 표시 제목. value_schema 내부에서는 JSON Schema 표시 제목이다.
            "title": "Context",
            // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
            "description": "유효성 검증 오류의 부가 문맥. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다."
          }
        },
        // 유효성 검증 오류의 종류를 식별하는 문자열.
        "type": "object",
        // 해당 객체에서 반드시 포함할 필드 이름 배열. 값이 null인지와 필드 생략 가능 여부는 별개다.
        "required": [
          "loc",
          "msg",
          "type"
        ],
        // 사용자 화면의 표시 제목. value_schema 내부에서는 JSON Schema 표시 제목이다.
        "title": "ValidationError"
      }
    },
    // OpenAPI 인증 방식 정의 모음.
    "securitySchemes": {
      // 서비스 로그인 쿠키를 사용하는 인증 방식. 토큰 발급 API를 뜻하지 않는다.
      "LoginSession": {
        // 콘텐츠 블록에서는 text/image/file, SSE envelope에서는 이벤트 이름을 구분한다. 이 객체의 실제 값을 기준으로 해석한다.
        "type": "apiKey",
        // 요청 파라미터 위치. path/query/header/cookie를 구분한다.
        "in": "cookie",
        // 요청 파라미터 이름. 인증 쿠키 또는 해당 API에서 선언한 파라미터 이름이다.
        "name": "dtest_session",
        // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
        "description": "Browser-managed cookie issued by corporate SSO login. Do not paste a cookie into Authorize."
      }
    }
  }
}
