---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	receive(receive)
	conversation(conversation)
	publish_review(publish_review)
	await_review(await_review)
	apply_review(apply_review)
	revise_plan(revise_plan)
	execution_select(execution_select)
	execution_submit(execution_submit)
	execution_register(execution_register)
	execution_wait(execution_wait)
	execution_receipt(execution_receipt)
	execution_process_event(execution_process_event)
	execution_review(execution_review)
	execution_decision_wait(execution_decision_wait)
	execution_decision_applied(execution_decision_applied)
	execution_finalize(execution_finalize)
	execution_cancel(execution_cancel)
	execution_report(execution_report)
	execution_repair_propose(execution_repair_propose)
	execution_repair_wait(execution_repair_wait)
	execution_repair_applied(execution_repair_applied)
	execution_repair_apply(execution_repair_apply)
	execution_repair_reject(execution_repair_reject)
