{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0-draft"
    },
    "workflow_id": {
      "$ref": "#/$defs/id"
    },
    "definition_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "maxLength": 150
      },
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "required": [
    "schema_version",
    "workflow_id",
    "definition_version",
    "name",
    "description",
    "goal",
    "inputs",
    "steps",
    "decisions",
    "expected_outputs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dtest:workflow-definition:2.0-draft",
  "title": "Workflow definition draft",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 150
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "workflow_input"
            },
            "name": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "source",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "literal"
            },
            "value": {}
          },
          "required": [
            "source",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "step_output"
            },
            "step_id": {
              "$ref": "#/$defs/id"
            },
            "selector": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            }
          },
          "required": [
            "source",
            "step_id",
            "selector"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "agent_decision"
            },
            "decision_id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "source",
            "decision_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "system_context"
            },
            "key": {
              "enum": [
                "user_id",
                "project_id",
                "session_id",
                "dataset_output_dir"
              ]
            }
          },
          "required": [
            "source",
            "key"
          ]
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in"
              ]
            },
            "left": {
              "$ref": "#/$defs/binding"
            },
            "right": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ]
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "parameter",
            "data_reference"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "value_schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "default": {}
      },
      "required": [
        "title",
        "description",
        "kind",
        "required",
        "editable",
        "value_schema"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "skill_id": {
          "$ref": "#/$defs/id"
        },
        "tool_id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "arguments": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 150
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "parameter_controls": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "editable",
              "value_schema"
            ],
            "properties": {
              "editable": {
                "type": "boolean"
              },
              "value_schema": {
                "type": [
                  "object",
                  "boolean"
                ]
              }
            }
          }
        }
      },
      "required": [
        "id",
        "skill_id",
        "tool_id",
        "description",
        "depends_on",
        "arguments"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "after_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "output_schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      },
      "required": [
        "id",
        "after_steps",
        "instruction",
        "output_schema"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "analysis_result",
            "dataset",
            "report"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "step_output"
                },
                "step_id": {
                  "$ref": "#/$defs/id"
                },
                "selector": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      }
                    ]
                  }
                }
              },
              "required": [
                "source",
                "step_id",
                "selector"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "agent_report"
                },
                "evidence_steps": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "source",
                "evidence_steps"
              ]
            }
          ]
        },
        "format": {
          "enum": [
            "native",
            "parquet",
            "markdown",
            "html",
            "json"
          ]
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required",
        "source",
        "format"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "SINGLE",
            "MULTI"
          ]
        },
        "repair_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "review_mode": {
          "enum": [
            "decision_boundary",
            "every_tool",
            "every_n_tools"
          ]
        },
        "review_interval_tools": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    }
  },
  "$comment": "Design draft only. Not accepted by the current runtime compiler or Workflow POST API."
}
