// 필드별 설명. 내부 실행 계획 참고 JSONC.
{
  // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
  "type": "object",
  // 정의되지 않은 필드 허용 여부 또는 동적 키의 값 schema. false면 임의 필드를 거절한다.
  "additionalProperties": false,
  // 객체 필드 이름별 검증 규칙.
  "properties": {
    // 계약 형식 버전. SSE는 1, 새 Workflow는 2.0-draft, legacy 예제는 1.3을 사용한다. 정의 수정 횟수와 구분한다. 필수 필드.
    "schema_version": {
      // 반드시 일치해야 하는 단일 고정값.
      "const": "2.0-draft",
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "계약 형식 버전. SSE는 1, 새 Workflow는 2.0-draft, legacy 예제는 1.3을 사용한다. 정의 수정 횟수와 구분한다. 필수 필드."
    },
    // 재사용 Workflow 정의를 식별하는 문자열. 기존 Workflow 관리 API의 DB UUID와 구분한다. 필수 필드.
    "workflow_id": {
      // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
      "$ref": "#/$defs/id",
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "재사용 Workflow 정의를 식별하는 문자열. 기존 Workflow 관리 API의 DB UUID와 구분한다. 필수 필드."
    },
    // 동일 Workflow 정의의 변경 버전. 승인 화면 편집 횟수나 Run ID가 아니다. 필수 필드.
    "definition_version": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "integer",
      // 허용 숫자의 포함 하한.
      "minimum": 1,
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "동일 Workflow 정의의 변경 버전. 승인 화면 편집 횟수나 Run ID가 아니다. 필수 필드."
    },
    // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다. 필수 필드.
    "name": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "string",
      // 허용 문자열의 최소 길이.
      "minLength": 1,
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다. 필수 필드."
    },
    // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열. 필수 필드.
    "description": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "string",
      // 허용 문자열의 최소 길이.
      "minLength": 1,
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열. 필수 필드."
    },
    // Workflow 또는 계획이 달성하려는 분석 목표. 필수 필드.
    "goal": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "string",
      // 허용 문자열의 최소 길이.
      "minLength": 1,
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "Workflow 또는 계획이 달성하려는 분석 목표. 필수 필드."
    },
    // 정의·검색·분류에 사용하는 문자열 태그 목록. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다.
    "tags": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "array",
      // 배열 원소에 적용할 Schema.
      "items": {
        // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
        "type": "string",
        // 허용 문자열의 최소 길이.
        "minLength": 1
      },
      // 배열 원소의 중복을 허용하지 않는지 표시한다.
      "uniqueItems": true,
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "정의·검색·분류에 사용하는 문자열 태그 목록. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다."
    },
    // 새 Workflow에서는 입력 이름별 정의 객체, PlanView에서는 입력 필드 목록, legacy에서는 실행 입력값 객체다. 필수 필드.
    "inputs": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "object",
      // Workflow 입력 이름 propertyNames. inputs는 정의, input_values는 해당 입력의 최종값이다.
      "propertyNames": {
        // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
        "type": "string",
        // 문자열이 만족해야 하는 정규식.
        "pattern": "^[a-z][a-z0-9_.-]*$",
        // 허용 문자열의 최대 길이.
        "maxLength": 150
      },
      // Workflow 입력 이름 additionalProperties. inputs는 정의, input_values는 해당 입력의 최종값이다.
      "additionalProperties": {
        // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
        "$ref": "#/$defs/input"
      },
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "새 Workflow에서는 입력 이름별 정의 객체, PlanView에서는 입력 필드 목록, legacy에서는 실행 입력값 객체다. 필수 필드."
    },
    // 분석 단계 목록. 새 Workflow의 Step은 하나의 등록 Tool을 참조하며 depends_on으로 선후관계를 정한다. 필수 필드.
    "steps": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "array",
      // 허용 배열의 최소 원소 수.
      "minItems": 1,
      // 배열 원소에 적용할 Schema.
      "items": {
        // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
        "$ref": "#/$defs/step"
      },
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "분석 단계 목록. 새 Workflow의 Step은 하나의 등록 Tool을 참조하며 depends_on으로 선후관계를 정한다. 필수 필드."
    },
    // 실행 결과를 보고 나중에 확정할 판단 목록. 정적 계획과 결과 기반 판단을 분리한다. 필수 필드.
    "decisions": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "array",
      // 배열 원소에 적용할 Schema.
      "items": {
        // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
        "$ref": "#/$defs/decision"
      },
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "실행 결과를 보고 나중에 확정할 판단 목록. 정적 계획과 결과 기반 판단을 분리한다. 필수 필드."
    },
    // 새 Workflow/PlanView에서는 실행 정책 객체. legacy Step/Tool에서는 실행 조건 값이다. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다.
    "execution": {
      // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
      "$ref": "#/$defs/execution",
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "새 Workflow/PlanView에서는 실행 정책 객체. legacy Step/Tool에서는 실행 조건 값이다. 생략 가능한 필드. 조건부 필수 여부는 업무 계약을 함께 확인한다."
    },
    // Workflow가 기대하는 분석 결과·데이터·보고서 선언. 선언만으로 파일이 생성되는 것은 아니다. 필수 필드.
    "expected_outputs": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "array",
      // 허용 배열의 최소 원소 수.
      "minItems": 1,
      // 배열 원소에 적용할 Schema.
      "items": {
        // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
        "$ref": "#/$defs/output"
      },
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "Workflow가 기대하는 분석 결과·데이터·보고서 선언. 선언만으로 파일이 생성되는 것은 아니다. 필수 필드."
    },
    // 순차 실행 호출 ID 목록. 데이터 필수 의존성과 별개이며 생략된 호출은 순서 장벽을 해제한다. 공개 2.0 변환기가 생성한다.
    "ordered_call_ids": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "array",
      // 허용 배열의 최소 원소 수.
      "minItems": 1,
      // 배열 원소의 중복을 허용하지 않는지 표시한다.
      "uniqueItems": true,
      // 배열 원소에 적용할 Schema.
      "items": {
        // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
        "$ref": "#/$defs/id"
      },
      // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
      "description": "순차 실행 호출 ID 목록. 데이터 필수 의존성과 별개이며 생략된 호출은 순서 장벽을 해제한다. 공개 2.0 변환기가 생성한다."
    }
  },
  // 해당 객체에서 반드시 포함할 필드 이름 배열. 값이 null인지와 필드 생략 가능 여부는 별개다.
  "required": [
    "schema_version",
    "workflow_id",
    "definition_version",
    "name",
    "description",
    "goal",
    "inputs",
    "steps",
    "decisions",
    "expected_outputs"
  ],
  // 사용하는 JSON Schema 명세 버전 URI.
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  // 이 Schema 문서를 식별하는 URI.
  "$id": "urn:dtest:workflow-definition:2.0-draft",
  // 사용자 화면의 표시 제목. value_schema 내부에서는 JSON Schema 표시 제목이다.
  "title": "Registered analysis Workflow definition",
  // 이 Schema에서 재사용하는 타입 정의 모음.
  "$defs": {
    // Workflow/Step/decision/산출물의 규격화된 문자열 ID.
    "id": {
      // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
      "type": "string",
      // 문자열이 만족해야 하는 정규식.
      "pattern": "^[a-z][a-z0-9_.-]*$",
      // 허용 문자열의 최대 길이.
      "maxLength": 150
    },
    // 입력값·리터럴·이전 결과·Agent 판단·시스템 문맥의 연결 구조.
    "binding": {
      // 열거한 Schema 중 정확히 하나에 맞아야 하는 선택 구조.
      "oneOf": [
        {
          // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
          "type": "object",
          // 정의되지 않은 필드 허용 여부 또는 동적 키의 값 schema. false면 임의 필드를 거절한다.
          "additionalProperties": false,
          // 객체 필드 이름별 검증 규칙.
          "properties": {
            // 값을 얻는 방식. workflow_input/literal/step_output/agent_decision/system_context, 보고서에서는 agent_report를 구분한다. 필수 필드.
            "source": {
              // 반드시 일치해야 하는 단일 고정값.
              "const": "workflow_input",
              // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
              "description": "값을 얻는 방식. workflow_input/literal/step_output/agent_decision/system_context, 보고서에서는 agent_report를 구분한다. 필수 필드."
            },
            // 해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다. 필수 필드.
            "name": {
              // 같은 문서의 정의 또는 components schema 참조. 실제 업무 데이터 값이 아니다.
              "$ref": "#/$defs/id",
              // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
              "description": "해당 입력·계획·Skill·함수 인자 등의 이름. binding의 name은 Workflow 입력 키를 참조한다. 필수 필드."
            }
          },
          // 해당 객체에서 반드시 포함할 필드 이름 배열. 값이 null인지와 필드 생략 가능 여부는 별개다.
          "required": [
            "source",
            "name"
          ]
        },
        {
          // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
          "type": "object",
          // 정의되지 않은 필드 허용 여부 또는 동적 키의 값 schema. false면 임의 필드를 거절한다.
          "additionalProperties": false,
          // 객체 필드 이름별 검증 규칙.
          "properties": {
            // 값을 얻는 방식. workflow_input/literal/step_output/agent_decision/system_context, 보고서에서는 agent_report를 구분한다. 필수 필드.
            "source": {
              // 반드시 일치해야 하는 단일 고정값.
              "const": "literal",
              // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
              "description": "값을 얻는 방식. workflow_input/literal/step_output/agent_decision/system_context, 보고서에서는 agent_report를 구분한다. 필수 필드."
            },
            // 직접 지정한 값·편집값·판단값. 의미와 허용 타입은 해당 입력 또는 파라미터 schema를 따른다. 필수 필드.
            "value": {
              // 해당 정의·입력·Skill·Step·산출물의 의미를 사람이 읽을 수 있게 설명한 문자열.
              "description": "직접 지정한 값·편집값·판단값. 의미와 허용 타입은 해당 입력 또는 파라미터 schema를 따른다. 필수 필드."
            }
          },
          // 해당 객체에서 반드시 포함할 필드 이름 배열. 값이 null인지와 필드 생략 가능 여부는 별개다.
          "required": [
            "source",
            "value"
          ]
        },
        {
          // 허용하는 JSON 데이터 타입. 이 Schema의 입력값 형식을 제한한다.
          "type": "object",
          // 정의되지 않은 필드 허용 여부 또는 동적 키의 값 schema. false면 임의 필드를 거절한다.
          "additionalProperties": false,
          // 객체 필드 이름별 검증 규칙.
          "properties": {
            // 값을 얻는 방식. workflow_input/literal/step_output/agent_decision/system_context, 보고서에서는 agent_report를 구분한다. 필수 필드.
            "source": {
              // 반드시 일치해야 하는 단일 고정값.
