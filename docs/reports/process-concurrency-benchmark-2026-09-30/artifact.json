    "sources": [
      {
        "id": "measurements",
        "label": "고정 소스의 실제 API·Worker·PostgreSQL 부하 측정",
        "path": "aggregation.sql",
        "query": {
          "engine": "sqlite",
          "language": "sql",
          "sql": "SELECT layout, users, CAST(CAST(users AS INTEGER) AS TEXT) || '명' AS cohort,\n COUNT(*) AS repeats, processes, concurrency, slots,\n AVG(mean_s) AS mean_s, AVG(p95_s) AS p95_s, AVG(queue_s) AS queue_s,\n AVG(llm_s) AS llm_s, AVG(internal_s) AS internal_s, AVG(throughput) AS throughput,\n MAX(peak_runs) AS peak_runs, AVG(cpu_s_user) AS cpu_s_user, AVG(cpu_cores) AS cpu_cores,\n AVG(rss_mib) AS rss_mib, AVG(db_peak) AS db_peak,\n AVG(pool_p95_ms) AS pool_p95_ms, AVG(lag_p95_ms) AS lag_p95_ms,\n MAX(lock_peak) AS lock_peak, MAX(idle_tx_peak) AS idle_tx_peak,\n AVG(sql_p95_ms) AS sql_p95_ms\n FROM benchmark_trials\n WHERE source_commit = 'c3534f0' AND users IN (10, 30, 50)\n GROUP BY layout, users, processes, concurrency, slots\n ORDER BY slots, processes, users",
          "description": "실제 HTTP/SSE 시나리오 완료 시간, Run 생성/시작 시각, 프로세스별 계측 및 pg_stat_activity 표본을 검산·집계한다.",
          "tables_used": [
            "benchmark_trials"
          ],
          "filters": [
            "source=c3534f0",
            "LLM mock=5 seconds per call, 4 calls per user",
            "Workflow approval waiting; no Executor submission",
            "users=10,30,50"
          ],
          "metric_definitions": [
