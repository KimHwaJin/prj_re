  "sources": [
    {
      "id": "measurements",
      "label": "격리된 로컬 HTTP·PostgreSQL A/B 측정 및 재현 가능한 집계",
      "path": "data/summary.json",
      "query": {
        "engine": "PostgreSQL + Python instrumentation",
        "language": "SQL + Python",
        "description": "scripts/benchmarks/analyze_db_scope.py로 raw-trials.jsonl.gz의 요청·풀·Run 실측을 집계. 예비 측정 제외.",
        "tables_used": [
          "public.agent_runs",
          "public.tasks",
          "public.session_executions",
          "public.messages",
          "public.agent_run_logs"
        ],
        "filters": [
          "before=64ad96f; after=4bb5c2f",
          "조건별 AB/BA 2회",
          "성공 응답 분위수와 실패 수 분리",
          "실제 외부 LLM·Executor 호출 없음"
        ],
        "metric_definitions": [
          "p95/p99=성공 요청의 pooled nearest-rank percentile",
          "Worker connection-seconds/Run=worker checkout→checkin 누적초 / Run 행 수",
          "queue_ms=started_at-created_at",
          "execution_ms=(completed_at 또는 interrupted updated_at)-started_at",
          "완료율=완료 시나리오 / 시도 시나리오"
        ],
        "sql": "-- Actual db_evidence() queries. These retrieve Run/status evidence only.\n-- HTTP/pool/model timers come from db_scope_server.py instrumentation;\n-- analyze_db_scope.py combines both sources. SQL alone does not produce timing percentiles.\nSELECT run_id,session_id,status,created_at,started_at,completed_at,updated_at,attempt_count,failure FROM agent_runs ORDER BY created_at;\nSELECT status,count(*) FROM agent_runs GROUP BY status;\nSELECT count(*) FROM tasks WHERE recovery_required;\nSELECT count(*) FROM session_executions WHERE token IS NOT NULL;\nSELECT count(*) FROM messages;\nSELECT count(*) FROM agent_run_logs;"
      }
    },
    {
      "id": "code",
      "label": "016 변경 직전/직후 소스 비교",
      "path": "sources/code-diff.patch"
    }
  ]
