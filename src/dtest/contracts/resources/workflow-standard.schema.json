{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workflow_version": {
      "const": "2.0",
      "description": "공개 작성 규격 버전. 고정 2.0이며 문서 수정 횟수가 아니다."
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Workflow 이름 또는 inputs에 정의한 입력 이름 참조."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "작성자가 제공하는 설명. 생략 가능한 곳에서는 정규화 규칙으로 보충한다."
        },
        "user_request": {
          "type": "string",
          "minLength": 1,
          "description": "재사용할 분석 목표. 특정 실행의 사용자 원문을 그대로 누적하는 필드가 아니다."
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          },
          "description": "입력 이름별 재사용 정의. 실제 값은 실행 계획 input_values에 저장한다."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          },
          "description": "Skill 그룹 배열. 그룹 순서와 내부 Tool 배열 순서대로 실행한다."
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "description": "실행 중 결과를 해석해야 하는 판단 목록. 선언하지 않은 판단을 임의로 삽입하지 않는다."
        },
        "execution": {
          "$ref": "#/$defs/execution",
          "description": "선택적 실행 정책. 공통 config/env 기본값과 서비스 상한을 적용한다."
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          },
          "description": "분석 결과·데이터·보고서의 기대사항과 근거. 선언만으로 파일 생성/등록되지는 않는다."
        }
      },
      "required": [
        "name",
        "user_request",
        "steps",
        "expected_outputs"
      ],
      "description": "재사용할 분석 정의. 실행별 실제 입력값·코드·실행 상태를 넣지 않는다."
    }
  },
  "required": [
    "workflow_version",
    "workflow"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dtest:workflow-standard:2.0",
  "title": "Public registered Workflow standard 2.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 150
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "input",
              "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
            },
            "name": {
              "$ref": "#/$defs/id",
              "description": "Workflow 이름 또는 inputs에 정의한 입력 이름 참조."
            }
          },
          "required": [
            "source",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "literal",
              "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
            },
            "value": {
              "description": "literal의 실제 JSON 값. null과 입력 누락은 다르다."
            }
          },
          "required": [
            "source",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "tool_output",
              "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
            },
            "call_id": {
              "$ref": "#/$defs/id",
              "description": "배열 위치가 아닌 고정 호출 ID. 선행 호출의 등록된 출력만 참조한다."
            },
            "output": {
              "$ref": "#/$defs/id",
              "description": "Tool 등록 메타데이터의 출력 별칭. 실제 반환값 selector는 등록 정보에서 해결한다."
            }
          },
          "required": [
            "source",
            "call_id",
            "output"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "agent_decision",
              "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
            },
            "decision_id": {
              "$ref": "#/$defs/id",
              "description": "decisions[].id 참조. 결과를 읽은 뒤 확정할 Agent 판단값이다."
            }
          },
          "required": [
            "source",
            "decision_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "system_context",
              "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
            },
            "key": {
              "enum": [
                "user_id",
                "project_id",
                "session_id",
                "dataset_output_dir"
              ],
              "description": "서비스 실행 문맥의 키. 실제 소유자·경로 값은 서버가 주입한다."
            }
          },
          "required": [
            "source",
            "key"
          ]
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in"
              ],
              "description": "eq/ne/gt/gte/lt/lte/in/not_in 중 하나. gt 계열은 숫자 비교다."
            },
            "left": {
              "$ref": "#/$defs/binding",
              "description": "조건 비교의 왼쪽 값 출처."
            },
            "right": {
              "$ref": "#/$defs/binding",
              "description": "조건 비교의 오른쪽 값 출처."
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "모든 하위 조건이 참이어야 한다."
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "하위 조건 하나 이상이 참이어야 한다."
            }
          },
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition",
              "description": "하위 조건 결과를 반전한다."
            }
          },
          "required": [
            "not"
          ]
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "입력 화면 표시 이름. 입력 정의에서 생략하면 입력 키를 사용한다."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "작성자가 제공하는 설명. 생략 가능한 곳에서는 정규화 규칙으로 보충한다."
        },
        "kind": {
          "enum": [
            "parameter",
            "data_reference"
          ],
          "description": "입력은 parameter/data_reference, 산출물은 analysis_result/dataset/report."
        },
        "required": {
          "type": "boolean",
          "description": "필수 입력 또는 기대 산출물 여부. false도 명시값으로 보존한다."
        },
        "editable": {
          "type": "boolean",
          "description": "사용자 변경 가능 여부. 실제 Tool 정책과 서비스 정책의 제한을 함께 적용한다."
        },
        "value_schema": {
          "type": [
            "object",
            "boolean"
          ],
          "description": "값 검증에 사용하는 로컬 JSON Schema. 원격 참조는 지원하지 않는다."
        },
        "default": {
          "description": "재사용 가능한 기본값. JSON Schema 검증기는 자동 삽입하지 않으며 정규화·승인기가 적용한다."
        }
      },
      "required": [
        "value_schema"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "그룹·호출·판단·산출물의 고정 식별자. Tool 등록 ID와 호출 ID를 구분한다."
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "판단 지침. 함께 고정한 Skill Markdown의 업무 지침도 판단에 제공한다."
        },
        "output_schema": {
          "type": [
            "object",
            "boolean"
          ],
          "description": "판단 결과 허용 타입·선택지·범위. Agent 값과 HITL 값을 모두 검증한다."
        },
        "after_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Agent 판단 전에 실제 성공 결과가 필요한 선행 호출 ID 목록."
        }
      },
      "required": [
        "id",
        "after_calls",
        "instruction",
        "output_schema"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "그룹·호출·판단·산출물의 고정 식별자. Tool 등록 ID와 호출 ID를 구분한다."
        },
        "kind": {
          "enum": [
            "analysis_result",
            "dataset",
            "report"
          ],
          "description": "입력은 parameter/data_reference, 산출물은 analysis_result/dataset/report."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "작성자가 제공하는 설명. 생략 가능한 곳에서는 정규화 규칙으로 보충한다."
        },
        "required": {
          "type": "boolean",
          "description": "필수 입력 또는 기대 산출물 여부. false도 명시값으로 보존한다."
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "tool_output",
                  "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
                },
                "call_id": {
                  "$ref": "#/$defs/id",
                  "description": "배열 위치가 아닌 고정 호출 ID. 선행 호출의 등록된 출력만 참조한다."
                },
                "output": {
                  "$ref": "#/$defs/id",
                  "description": "Tool 등록 메타데이터의 출력 별칭. 실제 반환값 selector는 등록 정보에서 해결한다."
                }
              },
              "required": [
                "source",
                "call_id",
                "output"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "agent_report",
                  "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
                },
                "evidence_calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  },
                  "uniqueItems": true,
                  "description": "보고서 작성에 사용할 실행 호출 ID 목록."
                }
              },
              "required": [
                "source",
                "evidence_calls"
              ]
            }
          ],
          "description": "literal/input/tool_output/agent_decision/system_context를 구분한다. 보고서 근거는 agent_report다."
        },
        "format": {
          "enum": [
            "native",
            "parquet",
            "markdown",
            "html",
            "json"
          ],
          "description": "native/parquet/markdown/html/json. 현재 자동 보고서 생성은 markdown이다."
        },
        "when": {
          "$ref": "#/$defs/condition",
          "description": "조건이 없으면 실행, false면 생략. 임의 Python 식을 실행하지 않는다."
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required",
        "source",
        "format"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "SINGLE",
            "MULTI"
          ],
          "description": "선택적 Executor SINGLE/MULTI 요구. static/adaptive 분류와 같은 개념이 아니다."
        },
        "repair_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "오류 수정 권한0~4. 초기 계획의 정상 결과 판단과 구분한다."
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "오류 수정 시도 상한. 서비스 상한 이내에서만 허용한다."
        },
        "review_mode": {
          "enum": [
            "decision_boundary",
            "every_tool",
            "every_n_tools"
          ],
          "description": "decision_boundary/every_tool/every_n_tools. 매 Tool 사이 LLM 호출이 기본은 아니다."
        },
        "review_interval_tools": {
          "type": "integer",
          "minimum": 1,
          "description": "every_n_tools일 때 필수인 양의 Tool 호출 간격."
        }
      },
      "required": []
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "그룹·호출·판단·산출물의 고정 식별자. Tool 등록 ID와 호출 ID를 구분한다."
        },
        "tool": {
          "$ref": "#/$defs/id",
          "description": "배포된 Tool 등록 ID. id는 이 함수를 사용하는 개별 호출 ID다."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "작성자가 제공하는 설명. 생략 가능한 곳에서는 정규화 규칙으로 보충한다."
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          },
          "description": "실제 함수 파라미터별 값 출처. 생략한 선택 인자는 원래 함수 기본값을 따른다.",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "when": {
          "$ref": "#/$defs/condition",
          "description": "조건이 없으면 실행, false면 생략. 임의 Python 식을 실행하지 않는다."
        },
        "parameter_controls": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "editable",
              "value_schema"
            ],
            "properties": {
              "editable": {
                "type": "boolean",
                "description": "사용자 변경 가능 여부. 실제 Tool 정책과 서비스 정책의 제한을 함께 적용한다."
              },
              "value_schema": {
                "type": [
                  "object",
                  "boolean"
                ],
                "description": "값 검증에 사용하는 로컬 JSON Schema. 원격 참조는 지원하지 않는다."
              }
            }
          },
          "description": "literal/Agent 판단 인자의 사용자 편집 범위를 선언한다. 참조 객체 편집에는 사용하지 않는다."
        }
      },
      "required": [
        "id",
        "tool"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "그룹·호출·판단·산출물의 고정 식별자. Tool 등록 ID와 호출 ID를 구분한다."
        },
        "skill": {
          "$ref": "#/$defs/id",
          "description": "배포된 Skill의 등록 ID. 디렉터리/함수 이름을 추측하여 해결하지 않는다."
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/call"
          },
          "description": "해당 Skill에서 사용할 Tool 호출 배열. 같은 Tool을 서로 다른 호출 ID로 여러 번 사용할 수 있다."
        }
      },
      "required": [
        "id",
        "skill",
        "tools"
      ]
    }
  },
  "$comment": "Authoring contract. Normalize against deployed assets before approval; never execute Tools during validation. Array order is sequential; references use stable call IDs. Defaults are implemented by the normalizer, not the JSON Schema validator."
}
